# Kan. Sheets BI — 環境変数サンプル
# このファイルをコピーして `.env.local` を作成し、実際の値を設定してください。
#   cp .env.example .env.local
#
# 実際の値（クライアントID・シークレット・秘密鍵等）はこのファイルにコミットしないこと。

# PostgreSQL 接続文字列（ローカル開発例: Docker や Neon/Supabase の接続情報を利用）
# 例: postgresql://postgres:postgres@localhost:5432/kan_sheets_bi?schema=public
DATABASE_URL=

# Auth.js セッション署名用シークレット（`pnpm exec auth secret` または `openssl rand -base64 32` で生成）
AUTH_SECRET=

# Google OAuth（Google Cloud Console > 認証情報 > OAuth クライアント ID で発行）
# 承認済みリダイレクト URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 共有キャッシュ（Sprint 4 以降で利用。Sprint 1 では未使用でも値を空のままにしてよい）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 印刷ルートへの内部アクセス用ベース URL（Sprint 8 以降で利用）
APP_URL=http://localhost:3000

# PDF 署名トークンの署名鍵（Sprint 8 以降で利用）
EXPORT_TOKEN_SECRET=

# エラートラッキング（任意）
SENTRY_DSN=

# 公開シートのみフォールバック利用する場合の任意キー（Sprint 2 以降で利用）
GOOGLE_SHEETS_API_KEY=
