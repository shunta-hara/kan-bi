# E2E テスト専用環境変数
# このファイルをコピーして .env.e2e を作成し、実際の値を設定してください。
#   cp .env.e2e.example .env.e2e
#
# .env.e2e は .gitignore で除外されているためコミットされません。
# このサンプルファイルはコミット対象です。

# E2E 専用 PostgreSQL 接続文字列 (本番 DB とは必ず別の DB を使うこと)
# 例: postgresql://postgres:postgres@localhost:5432/kan_sheets_bi_e2e?schema=public
DATABASE_URL=

# Auth.js セッション署名用シークレット (本番とは必ず別の値を使うこと)
# 例: openssl rand -base64 32
AUTH_SECRET=

# E2E アプリの起動 URL (ポート 3001 を使用)
AUTH_URL=http://localhost:3001

# Google OAuth クライアント (E2E では dummy でよい)
AUTH_GOOGLE_ID=dummy
AUTH_GOOGLE_SECRET=dummy

# Auth.js が localhost からのリクエストを許可するフラグ
AUTH_TRUST_HOST=true

# (任意) 使用する Chromium の実行ファイル。未設定なら Playwright 標準のブラウザを使う
# （事前に `pnpm exec playwright install chromium` を実行しておくこと）
# E2E_CHROMIUM_PATH=

# (任意) Playwright が期待するリビジョンのブラウザが無い環境で、サーバー側 PDF 生成用に
# 互換ブラウザ置き場を指定する。設定すると PLAYWRIGHT_BROWSERS_PATH として Next.js サーバーに渡される。
# 例: /path/to/compatible-browsers-dir（chromium-XXXX または chromium_headless_shell-XXXX を含むディレクトリ）
# E2E_SERVER_BROWSERS_PATH=
